# CorgiCoin example configuration file
# Copy to your data directory as corgicoin.conf:
#   Linux:   ~/.corgicoin/corgicoin.conf
#   macOS:   ~/Library/Application Support/CorgiCoin/corgicoin.conf
#   Windows: %APPDATA%\CorgiCoin\corgicoin.conf

# RPC credentials — required to use corgicoind as a server.
# Anyone with these credentials controls your wallet. Set your own password, long and random, and do not use
# '#' in it (it starts a comment). corgicoind refuses to run with the example value below.
rpcuser=corgirpc
#rpcpassword=CHANGE_THIS_PASSWORD
# or, with no password in this file: run contrib/rpcauth.py <user> and paste the rpcauth= line it prints
#rpcauth=<user>:<salt>$<hash>

# RPC port (default 62555). RPC listens on the loopback addresses only, unless rpcallowip is set, which opens
# the port on every network interface (and serves only the allowed addresses). Add rpcbind to listen on one
# address instead. rpcallowip takes an address, a wildcard (192.168.*) or a subnet (172.16.0.0/12).
#rpcport=62555
#rpcbind=127.0.0.1
#rpcallowip=172.16.0.0/12

# P2P port (default 62556)
#port=62556

# Seed nodes are built in (seed1.corgicoin.co / seed2.corgicoin.co), but you
# can pin them explicitly:
#addnode=seed1.corgicoin.co
#addnode=seed2.corgicoin.co

# Run as a daemon (Linux/macOS)
#daemon=1

# CPU mining: generate blocks with N threads (or use `setgenerate true N` via RPC)
#gen=1
#genproclimit=2

# Pay every mined block's reward to this one address (e.g. a treasury/pool),
# instead of a fresh wallet keypool address per block. Omit to use the keypool.
#mineraddress=CYourCorgiCoinAddressHere
